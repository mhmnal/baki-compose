<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg_dark">

    <TextView
        android:id="@+id/live_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LIVE SHIFT"
        android:textColor="@color/widget_muted_dark"
        android:textSize="11sp"
        android:letterSpacing="0.12" />

    <Chronometer
        android:id="@+id/live_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="@color/widget_ink_dark"
        android:textSize="30sp"
        android:textStyle="bold"
        android:format="%s" />

    <TextView
        android:id="@+id/live_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="Start a shift"
        android:textColor="@color/widget_ink_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/live_money"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="RM 0.00"
        android:textColor="@color/widget_muted_dark"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/live_toggle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_button"
        android:src="@drawable/ic_widget_pause"
        android:contentDescription="Pause or resume" />
</LinearLayout>
